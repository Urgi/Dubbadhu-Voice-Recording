{
  "name": "dubbadhu-voice-recording",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prune:lesson-json": "tsx scripts/prune-lesson-json-defaults.ts",
    "import:series2": "node scripts/import-series2-audio.cjs",
    "compute:word-waveforms": "node ../Dubbadhu/scripts/compute_word_waveforms.cjs --pending",
    "compute:word-waveforms:all-approved": "node ../Dubbadhu/scripts/compute_word_waveforms.cjs --all-approved",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "eas:ios:local": "EAS_BUILD_NO_EXPO_GO_WARNING=1 eas build --platform ios --profile production --local --non-interactive",
    "eas:ios:build-production": "EAS_BUILD_NO_EXPO_GO_WARNING=1 eas build --platform ios --profile production --non-interactive --no-wait",
    "eas:ios:submit-latest": "eas submit --platform ios --latest --non-interactive",
    "eas:ios:submit-both": "bash ../scripts/eas-submit-both-ios.sh"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/dom-webview": "55.0.3",
    "@google/generative-ai": "^0.24.1",
    "@react-native-community/slider": "5.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "@supabase/supabase-js": "^2.99.3",
    "expo": "~55.0.8",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "^55.0.11",
    "expo-font": "~55.0.4",
    "expo-image-manipulator": "~55.0.13",
    "expo-image-picker": "~55.0.13",
    "expo-linear-gradient": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-video-thumbnails": "~55.0.14",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-video-trim": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
