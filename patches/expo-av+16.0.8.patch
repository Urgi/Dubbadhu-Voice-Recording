+/// Resolves `EXPermissionsInterface` and registers mic requesters. Safe to call before `setModuleRegistry:` (JS may request permissions first).
+- (void)ensurePermissionsManager
+{
+  if (_permissionsManager != nil) {
+    return;
+  }
+  id<EXPermissionsInterface> resolved = nil;
+  if (_expoModuleRegistry != nil) {
+    resolved = [_expoModuleRegistry getModuleImplementingProtocol:@protocol(EXPermissionsInterface)];
+  }
+  if (resolved == nil) {
+    resolved = [EXPermissionsService new];
+  }
+  _permissionsManager = resolved;
+  [EXPermissionsMethodsDelegate registerRequesters:@[[EXAudioRecordingPermissionRequester new]] withPermissionsManager:_permissionsManager];
+}
