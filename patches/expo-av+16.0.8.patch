index 0000000..22bd736
--- /dev/null
+++ b/node_modules/expo-av/ios/EXAV/EXAVCompatMacros.h
@@ -0,0 +1,17 @@
+// Shims for macros removed from ExpoModulesCore in SDK 55+ (EXLog*, EXErrorWithMessage).
+#import <Foundation/Foundation.h>
+
+#ifndef EXAVCompatMacros_h
+#define EXAVCompatMacros_h
+
+#define EXLogWarn(...) NSLog(__VA_ARGS__)
+#define EXLogError(...) NSLog(__VA_ARGS__)
+#define EXLogInfo(...) NSLog(__VA_ARGS__)
+
+static inline NSError *EXAVNSErrorFromMessage(NSString *msg) {
+  return [NSError errorWithDomain:@"EXAV" code:0 userInfo:@{NSLocalizedDescriptionKey: msg}];
+}
+
+#define EXErrorWithMessage(msg) EXAVNSErrorFromMessage(msg)
+
+#endif
